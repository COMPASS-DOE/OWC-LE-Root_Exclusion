)
library(dplyr)
library(lubridate)
library(ggplot2)
library(patchwork)
# ---- Month levels for faceting (columns) ----
month_levels <- c("July", "August", "September", "October")
treatment_colors <- c("Control" = "#7AD151FF", "Root-free" = "#440154FF")
# ---- Climatology base: hour-of-day median per month, per Treat ----
df_climatology <- df_one_year %>%
mutate(month = lubridate::month(datetime, label = TRUE, abbr = FALSE),
hour  = lubridate::hour(datetime)) %>%
filter(month %in% month_levels) %>%
mutate(month = factor(month, levels = month_levels))
ch4_summary <- df_climatology %>%
group_by(month, hour, Treat) %>%
summarise(median_val = median(median_FCH4, na.rm = TRUE),
.groups = "drop")
swc_summary <- df_climatology %>%
group_by(month, hour, Treat) %>%
summarise(median_val = median(median_SWC, na.rm = TRUE),
.groups = "drop")
ts_summary <- df_climatology %>%
group_by(month, hour, Treat) %>%
summarise(median_val = median(median_TS, na.rm = TRUE),
.groups = "drop")
# ---- Sap flow: no Treat split, black point / gray smooth ----
sap_summary <- df_sap_OWC %>%
mutate(month = lubridate::month(datetime, label = TRUE, abbr = FALSE),
hour  = lubridate::hour(datetime)) %>%
filter(month %in% month_levels) %>%
mutate(month = factor(month, levels = month_levels)) %>%
group_by(month, hour) %>%
summarise(median_val = median(F, na.rm = TRUE),
.groups = "drop")
# ---- Generic hourly panel builder ----
make_hourly_plot <- function(df, ylab, treatment = TRUE,
show_x_axis = FALSE, show_strip = FALSE,
ylim_vals = NULL) {
if (treatment) {
g <- ggplot(df, aes(x = hour, y = median_val, color = Treat, fill = Treat)) +
geom_smooth(method = "loess", se = TRUE, alpha = 0.2) +
geom_point(size = 2) +
scale_color_manual(values = treatment_colors, name = "Treatment") +
scale_fill_manual(values = treatment_colors, name = "Treatment")
} else {
g <- ggplot(df, aes(x = hour, y = median_val)) +
geom_smooth(method = "loess", se = TRUE,
color = "black", fill = "gray50", alpha = 0.3) +
geom_point(color = "black", size = 2)
}
g <- g +
geom_vline(xintercept = c(9, 15), linetype = "dotted",
color = "black", linewidth = 0.6) +
facet_wrap(~ month, nrow = 1) +
scale_x_continuous(breaks = seq(0, 24, by = 6), limits = c(0, 23)) +
labs(x = if (show_x_axis) "Hour of day" else NULL, y = ylab) +
theme_bw() +
theme(
panel.grid = element_blank(),
text = element_text(size = 18),
axis.text.x = if (show_x_axis) element_text(size = 14) else element_blank(),
strip.background = element_rect(fill = "white", color = "black"),
strip.text = if (show_strip) element_text(size = 16, face = "bold") else element_blank()
)
if (!is.null(ylim_vals)) g <- g + coord_cartesian(ylim = ylim_vals)
return(g)
}
# ---- Build the 4 rows ----
p_ch4 <- make_hourly_plot(
ch4_summary,
ylab = bquote(atop("CH"[4] ~ "flux", ~ mu*mol ~ m^{-2} ~ s^{-1})),
treatment = TRUE, show_x_axis = FALSE, show_strip = TRUE,
ylim_vals = c(-2, 0.3)
)
p_swc <- make_hourly_plot(
swc_summary,
ylab = bquote(atop("Soil moisture", ~m^3 ~ m^{-3})),
treatment = TRUE, show_x_axis = FALSE, show_strip = FALSE,
ylim_vals = c(0, 0.55),
y_breaks = seq(0, 0.55, by = 0.1)
)
