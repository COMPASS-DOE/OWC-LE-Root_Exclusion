p_boot  = min(1, 2 * min(mean(bt >= 0, na.rm = TRUE), mean(bt <= 0, na.rm = TRUE))),
one_sd  = sd(d$x), n_days = n_distinct(d$DATE))
}
interaction_tbl <- tidyr::expand_grid(pv = proxy_vars, with_swc = c(FALSE, TRUE)) %>%
purrr::pmap_dfr(dfe_fit) %>%
mutate(ci_excludes_0 = sign(ci_low) == sign(ci_high))
print(interaction_tbl %>% dplyr::select(-pv, -one_sd) %>% mutate(across(where(is.double), ~ round(.x, 3))),
n = Inf, width = Inf)
# Same term in physical units: change in the Control-minus-Root-free CH4 flux per unit of
# the proxy (dividing by 1 SD of the proxy in the sample used).
interaction_tbl %>%
transmute(proxy, model, one_sd = signif(one_sd, 3), units = proxy_units[pv],
umol_per_unit = signif(interaction_umol_per_sd / one_sd, 3),
ci_low_unit   = signif(ci_low / one_sd, 3),
ci_high_unit  = signif(ci_high / one_sd, 3)) %>%
print(n = Inf, width = Inf)
fig_ch4_proxy <- trt_day %>%
tidyr::pivot_longer(any_of(c("sap_cum30", "gpp_cum30", "E_mean30")), names_to = "proxy", values_to = "value") %>%
filter(!is.na(value)) %>%
mutate(proxy = dplyr::recode(proxy, !!!proxy_lab)) %>%
ggplot(aes(value, fch4, colour = Treat)) +
geom_hline(yintercept = 0, linetype = "dashed", colour = "grey60") +
geom_point(alpha = 0.5, size = 1.5) +
geom_smooth(method = "lm", se = TRUE) +
facet_wrap(~ proxy, scales = "free_x") +
scale_colour_manual(values = treatment_colors) +
labs(x = NULL, y = bquote(CH[4] ~ "flux" ~ (mu*mol ~ m^{-2} ~ s^{-1})), colour = NULL) +
theme(panel.grid = element_blank(), legend.position = "top", text = element_text(size = 14))
print(fig_ch4_proxy)
ggsave("fig_ch4_vs_transpiration_proxy.png", fig_ch4_proxy, width = 12, height = 5, dpi = 300, bg = "white")
# Q6c. Does the lack of significance of the net treatment difference come from one atypical
# port (e.g. the spring CH4 hot spot in port 6) rather than from the absence of an effect?
#
# Each port is removed in turn and the randomization tests are repeated with the remaining
# 7 ports, keeping the real group sizes (3 vs 4): C(7, 3) = 35 assignments, so the smallest
# possible one-sided p is 1/35 = 0.029. Tested statistics:
#   - SEM: net transpiration effect on CH4 (diff_total, H1 < 0) and water-table -> SWC
#     coupling (diff_wt_swc, H1 > 0), Control minus Root-free;
#   - Direct test: Control x 30-d sap flux interaction with port and day effects (H1 < 0).
# This is a sensitivity analysis decided after seeing the results: the main result is the
# one with all 8 ports, and this table only shows how much each port drives it.
# Needs port_daily, sem_drivers, fit_sem(), labelled_est(), true_control (SEM robustness)
# and prep_dfe(), interaction_est() (Direct test and Causal tests).
lopo_proxy <- "sap_cum30"   # 30-d mean sap flux, the main proxy
# Daily medians for a set of "Control" ports, using only the ports in `pd`.
assign_data_from <- function(pd, control_ports, pv) {
pd %>%
mutate(Treat = factor(if_else(PORT %in% control_ports, "Control", "Root-free"),
levels = c("Control", "Root-free"))) %>%
group_by(DATE, Treat) %>%
summarise(swc = median(swc, na.rm = TRUE), fch4 = median(fch4, na.rm = TRUE),
ts = median(ts, na.rm = TRUE), .groups = "drop") %>%
left_join(sem_drivers %>% mutate(transp = .data[[pv]]), by = "DATE") %>%
dplyr::select(DATE, Treat, fch4, swc, ts, gwl, W, rain_7d, rain_30d, transp) %>%
filter(if_all(everything(), ~ !is.na(.x) & !is.nan(.x))) %>%
mutate(across(-c(DATE, Treat), z))
}
# One-sided randomization p and rank of the observed value among all assignments.
rank_p <- function(perm, obs, lower = TRUE) {
hits <- if (lower) perm <= obs + 1e-12 else perm >= obs - 1e-12
c(p = mean(hits, na.rm = TRUE), rank = sum(hits, na.rm = TRUE), n = sum(!is.na(perm)))
}
d_direct_all <- prep_dfe(lopo_proxy)
lopo_one <- function(drop_port) {
keep      <- setdiff(ports_all, drop_port)
ctrl_real <- intersect(true_control, keep)
assigns   <- combn(keep, length(ctrl_real), simplify = FALSE)
pd        <- filter(port_daily, PORT %in% keep)
# SEM statistics for every assignment of the remaining ports.
sem_stats <- purrr::map_dfr(assigns, function(a) {
fit <- tryCatch(suppressWarnings(fit_sem(assign_data_from(pd, a, lopo_proxy))), error = function(e) NULL)
est <- if (is.null(fit)) NULL else labelled_est(fit)
tibble(is_true = setequal(a, ctrl_real),
diff_total  = if (is.null(est)) NA_real_ else est[["diff_total"]],
diff_wt_swc = if (is.null(est)) NA_real_ else est[["diff_wt_swc"]])
})
obs_sem <- filter(sem_stats, is_true)
# Direct-test interaction for every assignment of the remaining ports.
d_dir <- d_direct_all %>% filter(as.character(PORT) %in% keep) %>% droplevels()
dir_stat <- function(a) interaction_est(d_dir, setNames(as.numeric(keep %in% a), keep))
dir_perm <- vapply(assigns, dir_stat, numeric(1))
dir_obs  <- dir_stat(ctrl_real)
r_tot <- rank_p(sem_stats$diff_total, obs_sem$diff_total, lower = TRUE)
r_wt  <- rank_p(sem_stats$diff_wt_swc, obs_sem$diff_wt_swc, lower = FALSE)
r_dir <- rank_p(dir_perm, dir_obs, lower = TRUE)
tibble(dropped_port = drop_port,
dropped_treat = port_treat$Treat[port_treat$PORT == drop_port],
n_assignments = length(assigns),
sem_diff_total = obs_sem$diff_total, p_diff_total = r_tot[["p"]], rank_diff_total = r_tot[["rank"]],
sem_diff_wt_swc = obs_sem$diff_wt_swc, p_diff_wt_swc = r_wt[["p"]], rank_diff_wt_swc = r_wt[["rank"]],
direct_interaction = dir_obs, p_direct = r_dir[["p"]], rank_direct = r_dir[["rank"]])
}
# Reference row with all 8 ports (70 assignments), from the earlier chunks.
all_ports_row <- tibble(
dropped_port = "none", dropped_treat = "-", n_assignments = 70L,
sem_diff_total  = perm_sem_tbl$diff_total_obs[perm_sem_tbl$proxy == names(sem_proxy)[sem_proxy == lopo_proxy]],
p_diff_total    = perm_sem_tbl$p_diff_total[perm_sem_tbl$proxy == names(sem_proxy)[sem_proxy == lopo_proxy]],
sem_diff_wt_swc = perm_sem_tbl$diff_wt_swc_obs[perm_sem_tbl$proxy == names(sem_proxy)[sem_proxy == lopo_proxy]],
p_diff_wt_swc   = perm_sem_tbl$p_diff_wt_swc[perm_sem_tbl$proxy == names(sem_proxy)[sem_proxy == lopo_proxy]])
lopo_tbl <- bind_rows(all_ports_row, purrr::map_dfr(ports_all, lopo_one)) %>%
mutate(across(c(sem_diff_total, sem_diff_wt_swc, direct_interaction), ~ round(.x, 3)),
across(starts_with("p_"), ~ round(.x, 3)))
print(lopo_tbl, n = Inf, width = Inf)
# Figure: one-sided p of each test when each port is removed (dashed line: p = 0.05;
# dotted line: smallest possible p with 7 ports, 1/35).
fig_lopo <- lopo_tbl %>%
filter(dropped_port != "none") %>%
tidyr::pivot_longer(c(p_diff_total, p_diff_wt_swc, p_direct), names_to = "test", values_to = "p") %>%
mutate(test = dplyr::recode(test,
p_diff_total  = "SEM: net effect on CH4",
p_diff_wt_swc = "SEM: water table -> SWC coupling",
p_direct      = "Direct test: Control x sap flux"),
port = paste0("Port ", dropped_port, "\n(", dropped_treat, ")")) %>%
ggplot(aes(port, p, colour = test, group = test)) +
geom_hline(yintercept = 0.05, linetype = "dashed", colour = "grey50") +
geom_hline(yintercept = 1 / 35, linetype = "dotted", colour = "grey50") +
geom_point(size = 3, position = position_dodge(width = 0.5)) +
scale_colour_manual(values = c("#7AD151FF", "#2A788EFF", "#440154FF")) +
labs(x = "Port removed", y = "Randomization p (one-sided)", colour = NULL) +
theme(panel.grid = element_blank(), legend.position = "top", text = element_text(size = 13))
print(fig_lopo)
ggsave("fig_leave_one_port_out.png", fig_lopo, width = 11, height = 5, dpi = 300, bg = "white")
# Q7. Below which water-table depth does the transpiration -> SWC -> CH4 chain start to act?
#
# Idea: while the water table is shallow, capillary rise keeps the surface soil wet whatever
# the trees do; once it drops below some depth, the surface soil dries and CH4 uptake rises.
# Three steps, each fitted per treatment on daily treatment medians:
#   (a) SWC vs water table: breakpoint where SWC starts to follow the water table
#       (segmented regression; Muggeo 2003);
#   (b) CH4 vs SWC (adjusted for soil temperature): breakpoint where drier soil starts to
#       increase uptake;
#   (c) transpiration effect on CH4 as a function of water-table depth (transpiration x
#       water-table interaction): the depths at which that effect is clearly different from
#       zero (Johnson-Neyman interval).
# Breakpoint CIs come from a 14-day block bootstrap (daily values are autocorrelated).
# Limit: days with the water table below the sensor (-0.49 m) are excluded from (a) and (c),
# so any threshold deeper than -0.49 m cannot be detected.
p_load(segmented)
n_boot_thr <- 500
thr_df <- resp_daily %>%
transmute(DATE, Treat, fch4, swc, ts, gwl = gwl_cens, transp = sap_cum30) %>%
filter(DATE >= win_start, DATE <= win_end)
# Breakpoint fit: returns the breakpoint, the slopes on each side and Davies' test p
# (H0: no change in slope). NULL when no breakpoint can be estimated.
fit_break <- function(d, form, z) {
m0  <- lm(form, data = d)
seg <- tryCatch(suppressWarnings(segmented(m0, seg.Z = reformulate(z), psi = median(d[[z]]))),
error = function(e) NULL)
if (is.null(seg) || is.null(seg$psi)) return(NULL)
sl <- slope(seg)[[z]]
list(psi = unname(seg$psi[1, "Est."]), slope_low = sl[1, "Est."], slope_high = sl[2, "Est."],
p_davies = davies.test(m0, seg.Z = reformulate(z))$p.value)
}
block_boot_break <- function(d, form, z, R = n_boot_thr) {
days   <- sort(unique(as.character(d$DATE)))
blocks <- split(days, ceiling(seq_along(days) / cv_block_days))
set.seed(42)
replicate(R, {
pick <- unlist(blocks[sample(seq_along(blocks), length(blocks), replace = TRUE)])
db   <- d[match(pick, as.character(d$DATE)), ]
b    <- fit_break(db, form, z)
if (is.null(b)) NA_real_ else b$psi
})
}
break_table <- function(form, z, label, data) {
purrr::map_dfr(c("Control", "Root-free"), function(tr) {
d <- data %>% filter(Treat == tr) %>% dplyr::select(DATE, all_of(all.vars(form))) %>% tidyr::drop_na()
b <- fit_break(d, form, z)
if (is.null(b)) return(tibble(relation = label, Treat = tr, n_days = nrow(d)))
bt <- block_boot_break(d, form, z)
tibble(relation = label, Treat = tr, n_days = nrow(d),
breakpoint = b$psi, ci_low = quantile(bt, 0.025, na.rm = TRUE), ci_high = quantile(bt, 0.975, na.rm = TRUE),
slope_below = b$slope_low, slope_above = b$slope_high, p_davies = b$p_davies)
})
}
# (a) SWC vs water table (m, relative to the ground), measured water-table days only.
# (b) CH4 vs SWC, adjusted for soil temperature, all days.
break_tbl <- bind_rows(
break_table(swc ~ gwl, "gwl", "SWC vs water table (m)", filter(thr_df, gwl > tr_floor)),
break_table(fch4 ~ swc + ts, "swc", "CH4 vs SWC (m3 m-3)", thr_df)) %>%
mutate(across(where(is.double), ~ signif(.x, 3)))
print(break_tbl, width = Inf)
# (c) Transpiration effect on CH4 conditional on the water-table depth. GLS with CAR(1)
# errors; the conditional slope at depth g is b_transp + b_interaction * g, with its SE from
# the coefficient covariance. Transpiration and temperature are standardized; the water
# table stays in metres so the depths can be read directly.
jn_curve <- function(tr) {
d <- thr_df %>% filter(Treat == tr, gwl > tr_floor) %>%
dplyr::select(DATE, fch4, transp, gwl, ts) %>% tidyr::drop_na() %>% arrange(DATE) %>%
mutate(transp_z = z(transp), ts_z = z(ts), day_num = as.numeric(DATE - min(DATE)))
m <- nlme::gls(fch4 ~ transp_z * gwl + ts_z, correlation = nlme::corCAR1(form = ~ day_num),
data = d, control = nlme::glsControl(opt = "optim"))
b <- coef(m); V <- vcov(m)
tibble(Treat = tr, gwl = seq(min(d$gwl), max(d$gwl), length.out = 100)) %>%
mutate(slope = b[["transp_z"]] + b[["transp_z:gwl"]] * gwl,
se    = sqrt(V["transp_z", "transp_z"] + gwl^2 * V["transp_z:gwl", "transp_z:gwl"] +
2 * gwl * V["transp_z", "transp_z:gwl"]),
lo = slope - 1.96 * se, hi = slope + 1.96 * se,
significant = sign(lo) == sign(hi),
p_interaction = summary(m)$tTable["transp_z:gwl", "p-value"])
}
jn <- purrr::map_dfr(c("Control", "Root-free"), jn_curve)
# Depth ranges where the transpiration effect on CH4 is clearly negative (more uptake).
jn %>%
filter(significant, slope < 0) %>%
group_by(Treat) %>%
summarise(shallowest_m = max(gwl), deepest_m = min(gwl), p_interaction = first(p_interaction), .groups = "drop") %>%
print()
fig_thr_a <- thr_df %>% filter(gwl > tr_floor) %>%
ggplot(aes(gwl, swc, colour = Treat)) +
geom_point(alpha = 0.4, size = 1.2) +
geom_vline(data = filter(break_tbl, relation == "SWC vs water table (m)"),
aes(xintercept = breakpoint, colour = Treat), linetype = "dashed") +
scale_colour_manual(values = treatment_colors) +
labs(x = "Water table (m, relative to ground)", y = bquote("SWC" ~ (m^3 ~ m^{-3})), colour = NULL, title = "(a)")
fig_thr_b <- thr_df %>%
ggplot(aes(swc, fch4, colour = Treat)) +
geom_hline(yintercept = 0, colour = "grey60") +
geom_point(alpha = 0.4, size = 1.2) +
geom_vline(data = filter(break_tbl, relation == "CH4 vs SWC (m3 m-3)"),
aes(xintercept = breakpoint, colour = Treat), linetype = "dashed") +
scale_colour_manual(values = treatment_colors) +
labs(x = bquote("SWC" ~ (m^3 ~ m^{-3})), y = bquote(CH[4] ~ (mu*mol ~ m^{-2} ~ s^{-1})), colour = NULL, title = "(b)")
fig_thr_c <- ggplot(jn, aes(gwl, slope, colour = Treat, fill = Treat)) +
geom_hline(yintercept = 0, colour = "grey60") +
geom_ribbon(aes(ymin = lo, ymax = hi), alpha = 0.2, colour = NA) +
geom_line(linewidth = 1) +
scale_colour_manual(values = treatment_colors) + scale_fill_manual(values = treatment_colors) +
labs(x = "Water table (m, relative to ground)",
y = bquote("Effect of transpiration on" ~ CH[4] ~ "(per SD)"), colour = NULL, fill = NULL, title = "(c)")
fig_thr <- (fig_thr_a | fig_thr_b | fig_thr_c) + patchwork::plot_layout(guides = "collect") &
theme(panel.grid = element_blank(), legend.position = "top", text = element_text(size = 12))
print(fig_thr)
ggsave("fig_water_table_thresholds.png", fig_thr, width = 14, height = 4.8, dpi = 300, bg = "white")
# Interaction test and the depth range (if any) where the transpiration effect on CH4 is
# clearly negative. An empty range means no depth within the measured water-table range.
jn %>%
group_by(Treat) %>%
summarise(p_interaction = first(p_interaction),
n_depths_significant = sum(significant & slope < 0),
shallowest_m = if (any(significant & slope < 0)) max(gwl[significant & slope < 0]) else NA_real_,
deepest_m    = if (any(significant & slope < 0)) min(gwl[significant & slope < 0]) else NA_real_,
.groups = "drop") %>%
print()
# Direction of the transpiration effect on CH4 along the water-table depth, per treatment:
# sign of the effect at the shallowest and deepest measured depths, and the depth ranges where
# it is significantly positive or negative.
jn %>%
group_by(Treat) %>%
summarise(p_interaction  = first(p_interaction),
effect_shallow = slope[which.max(gwl)], effect_deep = slope[which.min(gwl)],
sig_positive_from = if (any(significant & slope > 0)) min(gwl[significant & slope > 0]) else NA_real_,
sig_positive_to   = if (any(significant & slope > 0)) max(gwl[significant & slope > 0]) else NA_real_,
.groups = "drop") %>%
mutate(across(where(is.double), ~ round(.x, 3))) %>%
print()
# Q8. In what order do transpiration, water table, SWC and CH4 change after leaf-out?
#
# Observation from the time series: sap flux rises while the water table is still at the
# surface; once sap flux reaches its plateau the water table starts to fall, and a little
# later SWC falls and CH4 uptake increases. If transpiration drives the chain, the change
# dates must follow that order, with SWC and CH4 changing in Control plots and less (or
# later) in Root-free plots. A time order is evidence that a seasonal correlation alone
# does not give.
#
# For each daily series (spring to late summer 2024) a segmented regression on day of year
# finds the date where the trend changes (one breakpoint: the sap-flux plateau, the start
# of the water-table decline, the start of the SWC decline, the start of the CH4 decline,
# i.e. more uptake). CIs of the dates come from a block bootstrap of the residuals (7-day
# blocks added back to the fitted line), which keeps the autocorrelation. Only measured
# days are used; the water table is used until it reaches the sensor (-0.49 m).
p_load(segmented)
timing_start <- as.Date("2024-04-01")
timing_end   <- as.Date("2024-08-31")
n_boot_time  <- 300
res_block_t  <- 7
timing_series <- bind_rows(
drivers_all %>% transmute(DATE, series = "Sap flux (midday)", Treat = "Both", value = sap_mid),
wt_daily %>% filter(tr_obs) %>% transmute(DATE, series = "Water table (TR)", Treat = "Both", value = TR_obs),
resp_daily %>% transmute(DATE, series = "SWC", Treat, value = swc),
resp_daily %>% transmute(DATE, series = "CH4 flux", Treat, value = fch4)) %>%
filter(DATE >= timing_start, DATE <= timing_end, !is.na(value)) %>%
mutate(doy = yday(DATE))
# One breakpoint in time: date, slopes before and after (units per day) and Davies' test p.
fit_time_break <- function(d) {
m0  <- lm(value ~ doy, data = d)
seg <- tryCatch(suppressWarnings(segmented(m0, seg.Z = ~ doy, psi = median(d$doy))), error = function(e) NULL)
if (is.null(seg) || is.null(seg$psi)) return(NULL)
list(seg = seg, psi = unname(seg$psi[1, "Est."]), slopes = slope(seg)$doy[, "Est."],
p = davies.test(m0, seg.Z = ~ doy)$p.value)
}
# Residual block bootstrap: resample 7-day blocks of residuals, add them to the fitted
# breakpoint line and refit.
boot_time_break <- function(d, fit, R = n_boot_time) {
fv <- fitted(fit$seg); rs <- residuals(fit$seg); n <- length(rs)
starts <- seq_len(n - res_block_t + 1)
set.seed(42)
replicate(R, {
noise <- unlist(lapply(sample(starts, ceiling(n / res_block_t), replace = TRUE),
function(s) rs[s:(s + res_block_t - 1)]))[seq_len(n)]
b <- fit_time_break(mutate(d, value = fv + noise))
if (is.null(b)) NA_real_ else b$psi
})
}
to_date <- function(doy) as.Date(round(doy) - 1, origin = "2024-01-01")
timing_tbl <- timing_series %>%
group_by(series, Treat) %>%
group_modify(function(d, key) {
d   <- arrange(d, doy)
fit <- fit_time_break(d)
if (is.null(fit)) return(tibble(n_days = nrow(d)))
bt  <- boot_time_break(d, fit)
tibble(n_days = nrow(d),
change_date = to_date(fit$psi),
ci_low  = to_date(quantile(bt, 0.025, na.rm = TRUE)),
ci_high = to_date(quantile(bt, 0.975, na.rm = TRUE)),
slope_before = fit$slopes[1], slope_after = fit$slopes[2], p_davies = fit$p)
}) %>%
ungroup() %>%
mutate(days_after_sap_plateau = as.numeric(change_date - change_date[series == "Sap flux (midday)"]),
across(c(slope_before, slope_after, p_davies), ~ signif(.x, 3))) %>%
arrange(change_date)
print(timing_tbl, width = Inf)
# Timeline: every series rescaled to 0-1 so they share one axis; vertical line = change
# date, grey band = its 95% CI; green band = leaf-on.
timeline_df <- timing_series %>%
group_by(series, Treat) %>%
mutate(scaled = (value - min(value)) / (max(value) - min(value))) %>%
ungroup() %>%
mutate(panel = if_else(Treat == "Both", series, paste(series, "-", Treat)))
timeline_breaks <- timing_tbl %>%
mutate(panel = if_else(Treat == "Both", series, paste(series, "-", Treat)))
panel_order <- c("Sap flux (midday)", "Water table (TR)", "SWC - Control", "SWC - Root-free",
"CH4 flux - Control", "CH4 flux - Root-free")
fig_timing <- ggplot(mutate(timeline_df, panel = factor(panel, panel_order)), aes(DATE, scaled)) +
annotate("rect", xmin = leafon_start, xmax = timing_end, ymin = -Inf, ymax = Inf,
fill = "#7AD151FF", alpha = 0.08) +
geom_rect(data = mutate(timeline_breaks, panel = factor(panel, panel_order)), inherit.aes = FALSE,
aes(xmin = ci_low, xmax = ci_high, ymin = -Inf, ymax = Inf), fill = "grey60", alpha = 0.25) +
geom_line(colour = "grey25", linewidth = 0.6) +
geom_vline(data = mutate(timeline_breaks, panel = factor(panel, panel_order)),
aes(xintercept = change_date), colour = "#B2182B", linetype = "dashed") +
geom_text(data = mutate(timeline_breaks, panel = factor(panel, panel_order)),
aes(x = change_date, y = 1.05, label = format(change_date, "%d %b")),
colour = "#B2182B", size = 3.3, hjust = -0.1) +
facet_wrap(~ panel, ncol = 1, strip.position = "left") +
scale_y_continuous(breaks = NULL, limits = c(0, 1.15)) +
labs(x = NULL, y = NULL,
caption = "Each series rescaled to 0-1. Dashed line: change date (segmented regression); grey band: 95% CI (residual block bootstrap); green: leaf-on.") +
theme(panel.grid = element_blank(), strip.placement = "outside",
strip.text.y.left = element_text(angle = 0, hjust = 1), strip.background = element_blank(),
text = element_text(size = 12), plot.caption = element_text(hjust = 0))
print(fig_timing)
ggsave("fig_leafon_switch_timeline.png", fig_timing, width = 10, height = 9, dpi = 300, bg = "white")
print(fig_timing)
# Q8. In what order do transpiration, water table, SWC and CH4 change after leaf-out?
#
# Observation from the time series: sap flux rises while the water table is still at the
# surface; once sap flux reaches its plateau the water table starts to fall, and a little
# later SWC falls and CH4 uptake increases. If transpiration drives the chain, the change
# dates must follow that order, with SWC and CH4 changing in Control plots and less (or
# later) in Root-free plots.
#
# A single segmented breakpoint does not work here: the series have several phases and rain
# pulses, and the breakpoint locks on to a pulse instead of the start of the change. Change
# dates are therefore defined as in phenology: each series is smoothed with a 7-day running
# median; its spring level (median 15 Apr - 15 May, before leaf-on) and summer level (median
# 1 Jul - 15 Aug) are computed; the 20%, 50% and 80% dates are the first days on which the
# smoothed series has covered that fraction of the spring-to-summer change and stays there
# for at least 5 consecutive days. 20% = start of the change; for sap flux, 80% = plateau.
# CIs: block bootstrap of the residuals around the smoothed curve (7-day blocks).
# The water table uses the censored series (days below the sensor at -0.49 m), so its
# summer level is the sensor floor and the dates describe the decline down to it.
spring_win <- as.Date(c("2024-04-15", "2024-05-15"))
summer_win <- as.Date(c("2024-07-01", "2024-08-15"))
timing_start <- as.Date("2024-04-01")
timing_end   <- as.Date("2024-08-31")
n_boot_time  <- 300
blk          <- 7      # days per bootstrap block and smoothing window
run_min      <- 5      # consecutive days beyond the threshold
fractions    <- c(0.2, 0.5, 0.8)
timing_series <- bind_rows(
drivers_all %>% transmute(DATE, series = "Sap flux (midday)", Treat = "Both", value = sap_mid),
wt_daily %>% transmute(DATE, series = "Water table (TR)", Treat = "Both", value = gwl_cens),
resp_daily %>% transmute(DATE, series = "SWC", Treat, value = swc),
resp_daily %>% transmute(DATE, series = "CH4 flux", Treat, value = fch4)) %>%
filter(DATE >= timing_start, DATE <= timing_end)
# 7-day centred running median of measured days (NA when fewer than 4 of the 7 days exist).
smooth_med <- function(x) zoo::rollapply(x, blk, function(v) if (sum(!is.na(v)) < 4) NA_real_ else median(v, na.rm = TRUE),
align = "center", partial = TRUE)
# Dates at which the smoothed series covers each fraction of the spring-to-summer change
# for at least run_min consecutive days.
threshold_dates <- function(dates, sm) {
base <- median(sm[dates >= spring_win[1] & dates <= spring_win[2]], na.rm = TRUE)
summ <- median(sm[dates >= summer_win[1] & dates <= summer_win[2]], na.rm = TRUE)
frac <- (sm - base) / (summ - base)
sapply(fractions, function(f) {
ok  <- !is.na(frac) & frac >= f & dates >= spring_win[1]
run <- stats::filter(as.numeric(ok), rep(1, run_min), sides = 1)   # ok on the last run_min days
i   <- which(run == run_min)[1]
if (is.na(i)) NA_real_ else as.numeric(dates[i - run_min + 1])
})
}
timing_one <- function(d) {
d  <- d %>% tidyr::complete(DATE = seq(timing_start, timing_end, by = "day")) %>% arrange(DATE)
sm <- smooth_med(d$value)
obs_dates <- threshold_dates(d$DATE, sm)
# Residual block bootstrap around the smoothed curve (measured days only keep residuals).
rs <- d$value - sm; n <- length(rs)
starts <- seq_len(n - blk + 1)
set.seed(42)
bt <- t(replicate(n_boot_time, {
noise <- unlist(lapply(sample(starts, ceiling(n / blk), replace = TRUE), function(s) rs[s:(s + blk - 1)]))[seq_len(n)]
threshold_dates(d$DATE, smooth_med(sm + noise))
}))
tibble(fraction = paste0(fractions * 100, "%"),
date    = as.Date(obs_dates),
ci_low  = as.Date(apply(bt, 2, quantile, 0.025, na.rm = TRUE)),
ci_high = as.Date(apply(bt, 2, quantile, 0.975, na.rm = TRUE)),
spring_level = median(sm[d$DATE >= spring_win[1] & d$DATE <= spring_win[2]], na.rm = TRUE),
summer_level = median(sm[d$DATE >= summer_win[1] & d$DATE <= summer_win[2]], na.rm = TRUE))
}
timing_tbl <- timing_series %>%
group_by(series, Treat) %>%
group_modify(~ timing_one(.x)) %>%
ungroup()
# Lags relative to the sap-flux plateau (its 80% date).
sap_plateau <- timing_tbl$date[timing_tbl$series == "Sap flux (midday)" & timing_tbl$fraction == "80%"]
timing_tbl <- timing_tbl %>%
mutate(days_after_sap_plateau = as.numeric(date - sap_plateau),
across(c(spring_level, summer_level), ~ signif(.x, 3)))
print(timing_tbl %>% arrange(fraction, date), n = Inf, width = Inf)
# Timeline: smoothed series rescaled to 0-1 (spring level = 0, summer level = 1) so they share
# one axis; points mark the 20% (start) and 50% dates; shaded: spring and summer reference windows.
panel_order <- c("Sap flux (midday)", "Water table (TR)", "SWC - Control", "SWC - Root-free",
"CH4 flux - Control", "CH4 flux - Root-free")
timeline_df <- timing_series %>%
group_by(series, Treat) %>%
tidyr::complete(DATE = seq(timing_start, timing_end, by = "day")) %>%
arrange(DATE, .by_group = TRUE) %>%
mutate(sm = smooth_med(value)) %>%
left_join(timing_tbl %>% distinct(series, Treat, spring_level, summer_level), by = c("series", "Treat")) %>%
mutate(scaled = (sm - spring_level) / (summer_level - spring_level)) %>%
ungroup() %>%
mutate(panel = factor(if_else(Treat == "Both", series, paste(series, "-", Treat)), panel_order))
timeline_marks <- timing_tbl %>%
filter(fraction %in% c("20%", "50%"), !is.na(date)) %>%
mutate(panel = factor(if_else(Treat == "Both", series, paste(series, "-", Treat)), panel_order),
y = if_else(fraction == "20%", 0.2, 0.5))
fig_timing <- ggplot(timeline_df, aes(DATE, scaled)) +
annotate("rect", xmin = spring_win[1], xmax = spring_win[2], ymin = -Inf, ymax = Inf, fill = "grey70", alpha = 0.2) +
annotate("rect", xmin = summer_win[1], xmax = summer_win[2], ymin = -Inf, ymax = Inf, fill = "grey70", alpha = 0.2) +
geom_vline(xintercept = leafon_start, colour = "#7AD151FF", linewidth = 0.8) +
geom_hline(yintercept = c(0, 1), colour = "grey80") +
geom_line(colour = "grey25", linewidth = 0.6) +
geom_errorbarh(data = timeline_marks, aes(xmin = ci_low, xmax = ci_high, y = y), inherit.aes = FALSE,
height = 0.15, colour = "#B2182B") +
geom_point(data = timeline_marks, aes(x = date, y = y, shape = fraction), colour = "#B2182B", size = 2.6) +
facet_wrap(~ panel, ncol = 1, strip.position = "left") +
scale_shape_manual(values = c(`20%` = 17, `50%` = 16), name = "Share of the spring-to-summer change") +
scale_y_continuous(breaks = c(0, 1), labels = c("spring", "summer")) +
labs(x = NULL, y = NULL,
caption = "7-day running median rescaled between the spring (15 Apr-15 May) and summer (1 Jul-15 Aug) levels. Green line: leaf-on start.") +
theme(panel.grid = element_blank(), strip.placement = "outside", legend.position = "top",
strip.text.y.left = element_text(angle = 0, hjust = 1), strip.background = element_blank(),
text = element_text(size = 12), plot.caption = element_text(hjust = 0))
print(fig_timing)
ggsave("fig_leafon_switch_timeline.png", fig_timing, width = 10, height = 9, dpi = 300, bg = "white")
print(fig_timing)
print(vpd_tbl, n = Inf, width = Inf)
print(fig_sem)
# Chain model built from the links that the data can identify, each with the design that
# isolates it, then combined into effects on SWC and CH4 with a joint bootstrap.
#
# Link 1  ET -> water table. "Transpiration" is the extra leaf-on recession of the TR water
#         table (rain-free days, no barrier opening, adjusted for level and WTE; m_rec2),
#         which was specific to the woody plot (no such increase at WTE). It is NOT the
#         sap-flux proxy: sap flux did not track the daily recession. A counterfactual TR
#         without that extra recession is integrated day by day (with the level feedback
#         of the recession model); dWT_ET = observed - counterfactual (m, negative).
#         Steady state of the deficit = b_leaf / b_lvl (about 0.3 m with the current fit).
# Link 2a Water table -> SWC, per treatment (coupling, m3 m-3 per m), daily treatment
#         medians on complete-port days (Fix 1).
# Link 2b Local root uptake -> SWC (Control only): port-level SWC with port and day fixed
#         effects; day effects absorb everything shared (water table, rain, season), so
#         Control x leaf-on is the leaf-on SWC change in Control beyond its water-table
#         coupling (Control x water table is in the model).
# Link 3  SWC (and water table) -> CH4, per treatment, adjusted for soil temperature.
# Effects (leaf-on mean, each treatment):
#   dSWC_wt    = coupling_trt x mean(dWT_ET)
#   dSWC_local = Control x leaf-on (Control only)
#   dCH4       = sw_ch_trt x (dSWC_wt + dSWC_local) + wt_ch_trt x mean(dWT_ET)
# and the Control - Root-free difference, compared with the observed difference in
# difference (leaf-on minus leaf-off, Control minus Root-free) of SWC and CH4 -> % explained.
# Uncertainty: 14-day calendar-block bootstrap over days refitting every link, with one
# member of the gap-fill ensemble (Fix 3) drawn per replicate for the TR water table.
# Port randomization (70 assignments) for the treatment-specific local term.
# Needs m_rec2, rec2, gwl_ens, q_new, wb_daily, resp_daily_4p, swc_daily, cw_df,
# leafon_start, leafon_end, win_start, win_end, cv_block_days.
n_boot_chain <- 500
tr_full_from <- function(values) tibble(DATE = gwl_ens$DATE, TR_full = values)
tr_main <- tr_full_from(q_new[2, ])                        # median of the censored-inside ensemble
